<pipboy:PipboyWindow
    x:Class="Lemon.ShadowFiend.Views.ShellWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:Lemon.ShadowFiend.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lm="https://github.com/NeverMorewd/Lemon.ModuleNavigation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pipboy="clr-namespace:Pipboy.Avalonia;assembly=Pipboy.Avalonia"
    xmlns:vm="using:Lemon.ShadowFiend.ViewModels"
    Title="{Binding Title.Value, Source={x:Static app:AppContextModel.Current}}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:ShellViewModel"
	Name="shell"
	 TitleBarHeight="54"
    Icon="../Assets/lemon-50.png"
    Topmost="{Binding ElementName=toggle, Path=IsChecked}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Styles>
        <Style Selector="Image#WindowIcon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>
		<Style Selector="pipboy|PipboyWindow /template/ Image#PART_TitleBarIcon:pointerover">
			<Style.Animations>
				<Animation IterationCount="INFINITE" Duration="0:0:0.5">
					<KeyFrame Cue="0%">
						<Setter Property="RotateTransform.Angle" Value="1" />
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="RotateTransform.Angle" Value="360" />
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

	</Window.Styles>
	<pipboy:PipboyWindow.TitleBarContent>
		<ToggleSwitch
                Name="toggle"
                Height="25"
				HorizontalAlignment="Right"
                IsChecked="{Binding Path=IsTopMost.Value, Source={x:Static app:AppContextModel.Current}}"
                OffContent=""
                OnContent=""
                ToolTip.Tip="Topmost" />
	</pipboy:PipboyWindow.TitleBarContent>
    <Grid
        Margin="4,4,4,4"
        RowDefinitions="*,Auto"
        ShowGridLines="False">
        
        <ContentControl Grid.Row="0" lm:NavigationExtension.RegionName="MainRegion" />
        <ContentControl Grid.Row="1" lm:NavigationExtension.RegionName="ConsoleRegion" />
        <ProgressBar
            Grid.Row="0"
            Grid.RowSpan="3"
            Width="100"
            Height="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsIndeterminate="True"
            IsVisible="{Binding Busy.Value, Source={x:Static app:AppContextModel.Current}}"
            ShowProgressText="False" />
    </Grid>
</pipboy:PipboyWindow>
